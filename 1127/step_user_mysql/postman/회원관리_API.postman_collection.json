{
  "info": {
    "name": "회원관리 API (FastAPI + MySQL)",
    "description": "회원가입 → 조회 → 비밀번호 수정 → 탈퇴 순서로 실행하세요. 1번 회원가입이 성공하면 응답의 id가 컬렉션 변수 userId에 자동 저장됩니다.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://127.0.0.1:8000" },
    { "key": "userId", "value": "1" }
  ],
  "item": [
    {
      "name": "1. 회원가입",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('201 Created', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "    pm.collectionVariables.set('userId', pm.response.json().id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"홍길동\",\n    \"phone\": \"010-1234-5678\",\n    \"password\": \"pass1234\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
      }
    },
    {
      "name": "1-1. 회원가입 실패 (휴대폰 형식 오류 422)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"name\": \"홍길동\",\n    \"phone\": \"01012345678\",\n    \"password\": \"pass1234\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
      }
    },
    {
      "name": "2. 회원 목록 조회",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/users", "host": ["{{baseUrl}}"], "path": ["api", "users"] }
      }
    },
    {
      "name": "3. 회원 상세 조회",
      "request": {
        "method": "GET",
        "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
      }
    },
    {
      "name": "4. 비밀번호 수정",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"current_password\": \"pass1234\",\n    \"new_password\": \"newpass99\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/users/{{userId}}/password", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}", "password"] }
      }
    },
    {
      "name": "5. 회원 탈퇴",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n    \"password\": \"newpass99\"\n}",
          "options": { "raw": { "language": "json" } }
        },
        "url": { "raw": "{{baseUrl}}/api/users/{{userId}}", "host": ["{{baseUrl}}"], "path": ["api", "users", "{{userId}}"] }
      }
    }
  ]
}
